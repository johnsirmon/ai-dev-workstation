{
  "servers": {
    "context7": {
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@upstash/context7-mcp/dist/index.js"
      ],
      "type": "stdio",
      "env": {
        "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
      }
    },
    "memory": {
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@modelcontextprotocol/server-memory/dist/index.js"
      ],
      "type": "stdio",
      "env": {
        "MEMORY_FILE_PATH": "${workspaceFolder}/.mcp-memory.jsonl"
      }
    },
    "brave-search": {
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@brave/brave-search-mcp-server/dist/index.js",
        "--transport",
        "stdio"
      ],
      "env": {
        "BRAVE_API_KEY": "${env:BRAVE_API_KEY}"
      },
      "type": "stdio"
    },
    "filesystem": {
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@modelcontextprotocol/server-filesystem/dist/index.js",
        "${workspaceFolder}"
      ],
      "type": "stdio"
    }
  }
}